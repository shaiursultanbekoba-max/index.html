<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    
    <!-- ВАЖНО: делает сайт адаптивным под телефон -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Моя страница</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
            background: #f5f5f5;
        }

        .container {
            max-width: 400px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h1 {
            font-size: 22px;
        }

        button {
            width: 100%;
            background-color: red;
            color: white;
            padding: 15px;
            font-size: 18px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        #info {
            margin-top: 20px;
            display: none;
            font-size: 16px;
        }

        a {
            display: block;
            margin: 10px 0;
            padding: 12px;
            background: #25D366;
            color: white;
            border-radius: 8px;
            text-decoration: none;
        }

        .instagram {
            background: #E1306C;
        }

        /* Для компьютера (чуть шире) */
        @media (min-width: 768px) {
            .container {
                max-width: 500px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Нажми кнопку</h1>

    <button onclick="showInfo()">Показать данные</button>

    <div id="info">
        <p><strong>Жекшенбеков Азирет</strong></p>

        <a class="instagram" href="https://instagram.com/damer_azi" target="_blank">
            Instagram @damer_azi
        </a>

        <a href="https://wa.me/996550061123" target="_blank">
            WhatsApp +996 550 061 123
        </a>

